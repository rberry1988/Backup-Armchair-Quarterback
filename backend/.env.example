# ESPN league to sync (public leagues only need these two values)
ESPN_LEAGUE_ID=123456
ESPN_SEASON=2025

# Optional: only needed if your league is private. Pulled from browser cookies
# on fantasy.espn.com (DevTools -> Application -> Cookies) after logging in.
# ESPN_S2=
# ESPN_SWID=

# SQLite file location (relative to backend/ unless absolute)
DATABASE_URL=sqlite:///./data/fantasy.db

# Secret used to sign login sessions (JWTs). Set this to a long random
# string, e.g. `python3 -c "import secrets; print(secrets.token_hex(32))"`.
JWT_SECRET=change-me-to-a-random-string

# Comma-separated browser origins allowed to call the API cross-origin.
# Only matters when frontend and backend are served from different
# origins (e.g. local dev: Vite on :5173 calling the API on :8000). A
# same-origin production deployment behind a reverse proxy (see deploy/)
# never triggers CORS, so this can usually be left at the default there.
CORS_ORIGINS=http://localhost:5173

# Optional: enables the Expert Rankings tab and Trade Grader ECR context.
# Get a free key at https://www.fantasypros.com/api/. A free-tier key
# hard-caps every query at the top 10 results, so this only ever covers
# elite/startable players — everything else works fine without it.
# FANTASYPROS_API_KEY=
