# ESPN league to sync (public leagues only need these two values)
ESPN_LEAGUE_ID=123456
ESPN_SEASON=2025

# Optional: only needed if your league is private. Pulled from browser cookies
# on fantasy.espn.com (DevTools -> Application -> Cookies) after logging in.
# ESPN_S2=
# ESPN_SWID=

# SQLite file location (relative to backend/ unless absolute)
DATABASE_URL=sqlite:///./data/fantasy.db
