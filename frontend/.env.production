# Production builds (npm run build) call the API at a relative /api/...
# path on the same origin the frontend is served from, instead of the dev
# default of http://localhost:8000 — this is what lets the nginx setup in
# deploy/ serve both from one origin with no CORS needed. Override at
# build time (VITE_API_BASE_URL=https://api.example.com npm run build) if
# you're deploying the API on a different origin than the frontend.
VITE_API_BASE_URL=
