server {
    listen 80;
    server_name _;

    root __APP_DIR__/frontend/dist;
    index index.html;

    # The backend only listens on localhost — nginx is the single
    # externally-reachable entry point. Every API route in this app is
    # under /api/, so that's the only path that needs proxying; everything
    # else falls through to the React app's static files.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The Admin tab's self-update endpoint runs git pull + npm install +
        # npm run build inline before responding, which can take a couple of
        # minutes on a cold node_modules cache — well past nginx's 60s
        # default. Every other request here finishes in well under a second,
        # so a generous ceiling costs nothing.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        try_files $uri /index.html;
    }
}
