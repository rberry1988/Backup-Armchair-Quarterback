server {
    listen 80;
    server_name _;

    root __APP_DIR__/frontend/dist;
    index index.html;

    # The React bundle is ~275 KB uncompressed and ~83 KB gzipped. nginx's
    # packaged default only gzips text/html, so without this every visitor
    # pulls the full 275 KB. Not applied to images — they're already
    # compressed and re-compressing just burns CPU.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Clickjacking, MIME-sniffing, and referrer leakage. This app has no
    # reason to be framed or to send its URLs to third parties.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # The backend only listens on localhost — nginx is the single
    # externally-reachable entry point. Every API route in this app is
    # under /api/, so that's the only path that needs proxying; everything
    # else falls through to the React app's static files.
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The Admin tab's self-update endpoint runs git pull + npm install +
        # npm run build inline before responding, which can take a couple of
        # minutes on a cold node_modules cache — well past nginx's 60s
        # default. Every other request here finishes in well under a second,
        # so a generous ceiling costs nothing.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # Vite fingerprints everything under assets/ with a content hash, so a
    # given URL's bytes never change — a new build means new filenames.
    # That makes these safe to cache forever, which is what stops the
    # bundle being re-downloaded on every visit.
    location /assets/ {
        # One explicit Cache-Control rather than `expires 1y` as well, which
        # would emit a second, separate Cache-Control header.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        # add_header in a nested block drops the ones inherited from the
        # server block, so the security headers have to be repeated here.
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
    }

    location / {
        # index.html must never be cached: it's what points at the current
        # build's hashed asset filenames, so a stale copy would keep serving
        # the old app after an update.
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "same-origin" always;
        try_files $uri /index.html;
    }
}
